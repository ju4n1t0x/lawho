---
import NavBar from "./NavBar.astro";
import Hero from "./Hero.astro";
import Marquee from "./Marquee.astro";
import Historia from "./Historia.astro";
import Infancias from "./Infancias.astro";
import Impacto from "./Impacto.astro";
import Misiones from "./Misiones.astro";
import Donar from "./Donar.astro";
import Voluntariado from "./Voluntariado.astro";
import Footer from "./Footer.astro";
---

<div class="min-h-screen overflow-x-hidden selection:bg-sun/50">
  <NavBar />
  <main>
    <Hero />
    <Marquee />
    <Historia />
    <Infancias />
    <Impacto />
    <Misiones />
    <Donar />
    <Voluntariado />
  </main>
  <Footer />
</div>
