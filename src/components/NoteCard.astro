---
import type { LiveNoteEntry } from "../lib/notes";
import Reveal from "./Reveal.astro";

interface Props {
  note: LiveNoteEntry;
  delay?: number;
  reveal?: boolean;
}

const { note, delay = 0, reveal = true } = Astro.props;
const { image, title, subtitle, tag } = note.data;
---

{
  reveal ? (
    <Reveal delay={delay}>
      <a
        href={`/operativos-de-salud/${note.id}/`}
        class="lift block overflow-hidden rounded-[2rem] bg-card focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
      >
        <div class="photo-zoom">
          <img
            src={image}
            alt={title}
            loading="lazy"
            class="aspect-4/5 w-full object-cover"
          />
        </div>
        <div class="p-7">
          {tag && (
            <span class="rounded-full bg-sun px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-sun-foreground">
              {tag}
            </span>
          )}
          <h2 class="mt-4 font-display text-2xl font-semibold">{title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            {subtitle}
          </p>
        </div>
      </a>
    </Reveal>
  ) : (
    <a
      href={`/operativos-de-salud/${note.id}/`}
      class="lift block overflow-hidden rounded-[2rem] bg-card focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
    >
      <div class="photo-zoom">
        <img
          src={image}
          alt={title}
          loading="lazy"
          class="aspect-4/5 w-full object-cover"
        />
      </div>
      <div class="p-7">
        {tag && (
          <span class="rounded-full bg-sun px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-sun-foreground">
            {tag}
          </span>
        )}
        <h2 class="mt-4 font-display text-2xl font-semibold">{title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          {subtitle}
        </p>
      </div>
    </a>
  )
}
