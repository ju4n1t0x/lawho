---
import type { NoteRecord } from "../lib/notes-repo";

interface Props {
  note: NoteRecord;
}

const { note } = Astro.props;
const { slug, data } = note;
const { title, subtitle, tag, image } = data;
---

<div class="lift flex overflow-hidden rounded-[2rem] bg-card focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2">
  {image && (
    <div class="photo-zoom w-48 shrink-0 sm:w-56">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  )}
  <div class="flex flex-1 items-center gap-6 p-5 sm:p-6">
    <div class="min-w-0 flex-1">
      {tag && (
        <span class="rounded-full bg-sun px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-sun-foreground">
          {tag}
        </span>
      )}
      <h2 class="mt-3 font-display text-xl font-semibold sm:text-2xl">{title}</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{subtitle}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href={`/escritor/editar/${slug}/`}
        class="inline-flex items-center justify-center rounded-full bg-sun px-5 py-2 text-sm font-semibold text-sun-foreground transition-colors hover:opacity-90 focus-visible:ring-2 focus-visible:ring-sun focus-visible:ring-offset-2"
      >
        Editar
      </a>
      <form method="POST" action={`/escritor/eliminar/${slug}/`} onsubmit="return confirm('¿Eliminar esta nota?')">
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-2 text-sm font-semibold text-accent-foreground transition-colors hover:opacity-90 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        >
          Eliminar
        </button>
      </form>
    </div>
  </div>
</div>
