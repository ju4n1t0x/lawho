---
import type { CollectionEntry } from "astro:content";
import { formatNoteDate } from "../lib/notes";

interface Props {
  note: CollectionEntry<"notes">;
  Content: any;
}

const { note, Content } = Astro.props;
const { image, title, subtitle, date, author, tag } = note.data;
---

<article class="mx-auto max-w-3xl px-4 py-24 md:py-32">
  <header>
    <div class="photo-zoom overflow-hidden rounded-[2.5rem]">
      <img
        src={image.src}
        alt={title}
        width={image.width}
        height={image.height}
        class="aspect-[16/9] w-full object-cover"
      />
    </div>

    <div class="mt-10">
      {
        tag && (
          <span
            class="rounded-full bg-sun px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-sun-foreground"
          >
            {tag}
          </span>
        )
      }
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight md:text-5xl">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{subtitle}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
        <time datetime={date.toISOString()}>{formatNoteDate(date)}</time>
        {author && (
          <>
            <span aria-hidden="true">·</span>
            <span>{author}</span>
          </>
        )}
      </div>
    </div>
  </header>

  <div class="note-body mt-12">
    <Content />
  </div>
</article>

<style>
  .note-body :global(p) {
    margin-block: 1.25rem;
    line-height: 1.8;
    color: var(--color-foreground);
  }

  .note-body :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note-body :global(h3) {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
  }

  .note-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .note-body :global(ul),
  .note-body :global(ol) {
    margin-block: 1.25rem;
    padding-inline-start: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .note-body :global(ul) {
    list-style: disc;
  }

  .note-body :global(ol) {
    list-style: decimal;
  }

  .note-body :global(blockquote) {
    margin-block: 1.5rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--color-accent);
    color: var(--color-muted-foreground);
  }

  .note-body :global(strong) {
    font-weight: 700;
  }

  .note-body :global(img) {
    margin-block: 1.5rem;
    border-radius: 1.5rem;
  }
</style>
