---
import CountUp from "./CountUp.astro";
import heroNinos from "../assets/ninos-esperanza.jpg";
---

<section class="relative px-4 pt-10 pb-16 md:pt-16">
  <div
    class="pointer-events-none absolute -left-24 top-10 -z-10 size-[26rem] animate-drift rounded-full bg-sun/40 blur-3xl"
  ></div>
  <div
    class="pointer-events-none absolute -right-20 top-52 -z-10 size-[22rem] animate-drift rounded-full bg-accent/20 blur-3xl [animation-delay:-6s]"
  ></div>

  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.05fr_1fr]">
    <div class="animate-fade-up">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-card px-4 py-2 text-xs font-semibold uppercase tracking-widest text-accent"
      >
        <span class="inline-block size-2 animate-heartbeat rounded-full bg-accent"></span>
        Chaco Salteño &middot; Salta, Argentina
      </span>
      <h1
        class="mt-7 text-balance font-display text-5xl font-semibold leading-[1.02] tracking-tight md:text-7xl"
      >
        En wichí, lawho significa{" "}
        <span class="relative inline-block text-accent">
          flor
          <svg viewBox="0 0 300 16" aria-hidden="true" class="absolute -bottom-1 left-0 w-full text-sun">
            <path
              d="M2 11C60 3 120 3 180 8s90 6 118 1"
              fill="none"
              stroke="currentColor"
              stroke-width="6"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>{" "}
        : florecer pese a todo.
      </h1>
      <p class="mt-7 max-w-[54ch] text-pretty text-lg leading-relaxed text-muted-foreground">
        Somos una asociación civil de médicos, voluntarios y colaboradores que realizamos operativos
        de salud ad honorem en comunidades de pueblos originarios del norte argentino, sin fines
        políticos ni religiosos y con profundo respeto por su cultura, creencias y costumbres.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#donar"
          class="rounded-full bg-accent px-8 py-4 font-semibold text-accent-foreground transition-transform hover:scale-105"
        >
          Doná y hacé posible el próximo viaje
        </a>
        <a
          href="#historia"
          class="rounded-full border border-foreground/20 px-8 py-4 font-semibold transition-colors hover:bg-card"
        >
          Nuestra historia
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="photo-zoom overflow-hidden rounded-[2.5rem] rounded-tr-[6rem]">
        <img
          src={heroNinos.src}
          alt="Niñas y niños de una comunidad originaria del norte argentino corriendo y riendo"
          width={1408}
          height={1008}
          class="aspect-[5/4] w-full animate-slow-zoom object-cover"
        />
      </div>
      <div
        class="absolute -bottom-8 -left-4 animate-float-soft rounded-3xl bg-leaf px-6 py-5 text-leaf-foreground md:-left-10"
      >
        <div class="font-display text-3xl font-semibold">
          <CountUp value={2000} prefix="+" />
        </div>
        <div class="text-xs uppercase tracking-widest opacity-80">
          consultas por
          <br />
          operativo
        </div>
      </div>
      <div
        class="absolute -right-2 -top-6 hidden rotate-6 animate-float-soft rounded-2xl bg-sun px-5 py-3 text-sm font-semibold text-sun-foreground [animation-delay:-3s] md:block"
      >
        Atención 100% ad honorem
      </div>
    </div>
  </div>
</section>
