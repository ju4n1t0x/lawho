---
---

<nav class="sticky top-0 z-50 px-4 pt-4">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-border/70 bg-background/80 py-2 pl-6 pr-2 backdrop-blur-md"
  >
    <span class="flex flex-col leading-none">
      <span class="font-display text-xl font-extrabold tracking-tight">LAWHO</span>
      <span class="text-[9px] font-medium uppercase tracking-[0.32em] text-muted-foreground">
        Fundación sanitaria
      </span>
    </span>

    <div class="hidden items-center gap-7 text-sm font-medium md:flex">
      <a href="#historia" class="transition-colors hover:text-accent">Historia</a>
      <a href="#infancias" class="transition-colors hover:text-accent">Infancias</a>
      <a href="#misiones" class="transition-colors hover:text-accent">Terreno</a>
      <a href="#voluntariado" class="transition-colors hover:text-accent">Sumate</a>
      <a href="/operativos-de-salud/" class="transition-colors hover:text-accent">
        Operativos de salud
      </a>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="#donar"
        class="rounded-full bg-accent px-6 py-3 text-sm font-bold text-accent-foreground transition-transform hover:scale-105"
      >
        Doná
      </a>
      <button
        type="button"
        id="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="grid size-11 place-items-center rounded-full border border-border/70 text-foreground transition-colors hover:text-accent md:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-drawer" class="nav-drawer mx-auto mt-2 max-w-6xl md:hidden">
    <a href="#historia" class="nav-drawer__link">Historia</a>
    <a href="#infancias" class="nav-drawer__link">Infancias</a>
    <a href="#misiones" class="nav-drawer__link">Terreno</a>
    <a href="#voluntariado" class="nav-drawer__link">Sumate</a>
    <a href="/operativos-de-salud/" class="nav-drawer__link">Operativos de salud</a>
    <a
      href="#donar"
      class="mt-2 rounded-full bg-accent px-6 py-3 text-center text-sm font-bold text-accent-foreground transition-transform hover:scale-105"
    >
      Doná
    </a>
  </div>
</nav>

<script>
  (() => {
    const toggle = document.getElementById("nav-toggle");
    const drawer = document.getElementById("mobile-drawer");
    if (!toggle || !drawer) return;

    const setOpen = (open: boolean) => {
      drawer.classList.toggle("nav-drawer--open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(!drawer.classList.contains("nav-drawer--open"));
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  })();
</script>

<style>
  .nav-drawer {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 1.5rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    backdrop-filter: blur(12px);
  }

  .nav-drawer--open {
    display: flex;
  }

  .nav-drawer__link {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-drawer__link:hover {
    color: var(--color-accent);
  }
</style>
