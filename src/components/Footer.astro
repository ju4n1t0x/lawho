---
const INSTAGRAM_URL = "https://www.instagram.com/lawho_medicos_voluntarios/";
const EMAIL_URL = "mailto:elimacedo1806@gmail.com";

const year = new Date().getFullYear();
---

<footer class="border-t border-border px-4 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 text-center">
    <span class="flex flex-col items-center leading-none">
      <img
        class="h-12 w-38 shrink-0"
        src="/favicon.svg"
        alt="LaWho"
        width="54"
        height="54"
      />
      <span
        class="mt-3 text-[10px] font-medium uppercase tracking-[0.32em] text-muted-foreground"
      >
        Grupo de Médicos Voluntarios
      </span>
    </span>
    <p class="max-w-[46ch] text-sm text-muted-foreground">
      LAWHO Organización sin fines de lucro &mdash; operativos de salud en el
      Chaco Salteño, Departamento Rivadavia Banda Norte, Salta. Contacto: Dra.
      Elizabeth Macedo, 351-744-2040.
    </p>
    <div class="flex gap-6 text-sm">
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-accent"
      >
        Instagram
      </a>
      <a href={EMAIL_URL} class="transition-colors hover:text-accent"
        >lawhoasociacioncivil@gmail.com</a
      >
    </div>
    <p class="text-[11px] uppercase tracking-[0.25em] text-muted-foreground/60">
      &copy; {year} Ignia Labs - Sasia Juan Ignacio.
    </p>
  </div>
</footer>
