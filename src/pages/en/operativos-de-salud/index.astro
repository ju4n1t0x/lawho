---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedNotes } from "../../../lib/notes";

const notes = getPublishedNotes(await getCollection("notes"));
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-4 py-24 md:py-32">
    <header class="mb-14 flex flex-col items-baseline justify-between gap-4 md:flex-row">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.25em] text-muted-foreground">
          Operativos de salud
        </p>
        <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight md:text-5xl">
          Bitácora del terreno
        </h1>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Relatos, aprendizajes y crónicas de cada operativo de salud que realizamos
          junto a las comunidades del Chaco Salteño.
        </p>
      </div>
    </header>

    {
      notes.length === 0 ? (
        <p class="text-muted-foreground">
          Todavía no hay operativos publicados. Volvé pronto.
        </p>
      ) : (
        <div class="grid gap-8 md:grid-cols-3">
          {notes.map((note) => (
            <a
              href={`/operativos-de-salud/${note.slug}/`}
              class="lift overflow-hidden rounded-[2rem] bg-card"
            >
              <div class="photo-zoom">
                <img
                  src={note.data.image.src}
                  alt={note.data.title}
                  loading="lazy"
                  width={note.data.image.width}
                  height={note.data.image.height}
                  class="aspect-[4/5] w-full object-cover"
                />
              </div>
              <div class="p-7">
                <h2 class="font-display text-2xl font-semibold">{note.data.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  {note.data.subtitle}
                </p>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
