---
import { getLiveEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NoteTemplate from "../../../components/NoteTemplate.astro";
import { SESSION_COOKIE_NAME } from "../../../lib/session";
import { getActiveSession } from "../../../lib/session-repo";

export const prerender = false;

const { slug } = Astro.params;
const result = await getLiveEntry("notes", slug ?? "");
const entry = result.entry;
if (!entry) {
  return new Response(null, { status: 404 });
}
const { Content } = await render(entry);

const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
const isWriter = sessionToken ? !!(await getActiveSession(sessionToken)) : false;
---

<BaseLayout>
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 pt-8">
    <a
      href="/en/"
      class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
    >
      <span aria-hidden="true">←</span>
      Back to home
    </a>
    {isWriter && (
      <a
        href="/escritor/"
        class="inline-flex items-center gap-2 rounded-full bg-leaf px-4 py-2 text-sm font-semibold text-leaf-foreground transition-colors hover:opacity-90"
      >
        Back to /escritor
      </a>
    )}
  </div>
  <NoteTemplate note={entry} Content={Content} />
</BaseLayout>
