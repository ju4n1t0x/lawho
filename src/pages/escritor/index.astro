---
import { SESSION_TTL_MS } from "astro:env/server";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoginForm from "../../components/server-islands/LoginForm.astro";
import WriterNoteCard from "../../components/WriterNoteCard.astro";
import { checkPassword } from "../../lib/users-repo";
import { createSession } from "../../lib/session-repo";
import { listAllNotesIncludingDrafts } from "../../lib/notes-repo";
import {
  SESSION_COOKIE_NAME,
  generateSessionToken,
  sessionCookieOptions,
} from "../../lib/session";

export const prerender = false;

let error: string | undefined;

// Handle the login form POST here. Server islands cannot receive form POSTs:
// they are fetched via a separate `/_server-islands/*` protocol, so the page
// owns the credential check, session creation and redirect.
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = String(formData.get("email") ?? "").trim();
  const password = String(formData.get("password") ?? "");

  const user = await checkPassword(email, password);
  if (!user) {
    error = "Credenciales incorrectas";
  } else {
    const token = generateSessionToken();
    await createSession(user.id, token, SESSION_TTL_MS);
    Astro.cookies.set(
      SESSION_COOKIE_NAME,
      token,
      sessionCookieOptions(SESSION_TTL_MS, import.meta.env.PROD),
    );
    return Astro.redirect("/escritor/");
  }
}

// Middleware already populates Astro.locals.user when a valid session exists.
const isAuthenticated = !!Astro.locals.user;
const notes = isAuthenticated ? await listAllNotesIncludingDrafts() : [];
---

<BaseLayout>
  <main class="mx-auto min-h-screen max-w-6xl px-4 py-24 md:py-32">
    {isAuthenticated ? (
      <div>
        <div class="mb-8 flex items-center justify-between">
          <h1 class="font-display text-3xl font-semibold">Mis notas</h1>
          <a
            href="/escritor/nueva"
            class="inline-flex items-center justify-center rounded-full bg-leaf px-6 py-2.5 text-sm font-semibold text-leaf-foreground transition-colors hover:opacity-90 focus-visible:ring-2 focus-visible:ring-leaf focus-visible:ring-offset-2"
          >
            + Crear nota
          </a>
        </div>
        {notes.length === 0 ? (
          <p class="text-center text-muted-foreground">
            Todavía no hay notas. Creá la primera con el botón de arriba.
          </p>
        ) : (
          <div class="grid gap-6">
            {notes.map((note) => (
              <WriterNoteCard note={note} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="flex justify-center">
        <LoginForm server:defer error={error} />
      </div>
    )}
  </main>
</BaseLayout>
