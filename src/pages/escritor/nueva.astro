---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WriterForm from "../../components/server-islands/WriterForm.astro";
import {
  MAX_UPLOAD_SIZE_BYTES,
  PUBLIC_UPLOADS_URL,
  UPLOADS_DIR,
} from "astro:env/server";
import { createNote, slugify } from "../../lib/notes-repo";
import { saveImageUpload } from "../../lib/uploads";
import { SESSION_COOKIE_NAME } from "../../lib/session";
import { getActiveSession } from "../../lib/session-repo";

export const prerender = false;

interface FormValues {
  title: string;
  subtitle: string;
  body: string;
  tag: string;
}

let error: string | undefined;
let values: FormValues = { title: "", subtitle: "", body: "", tag: "" };

/** Guard against non-`File` entries returned by the multipart parser. */
function isNonEmptyFile(value: unknown): value is File {
  return (
    value !== null &&
    typeof value === "object" &&
    "size" in value &&
    typeof (value as File).size === "number" &&
    (value as File).size > 0 &&
    "arrayBuffer" in value
  );
}

// The page owns the publish POST (server islands cannot receive form POSTs):
// validate, persist the image, insert the note, then redirect to its public URL.
if (Astro.request.method === "POST") {
  const token = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
  const session = token ? await getActiveSession(token) : null;
  if (!session) {
    return Astro.redirect("/escritor/");
  }

  const formData = await Astro.request.formData();
  values = {
    title: String(formData.get("title") ?? "").trim(),
    subtitle: String(formData.get("subtitle") ?? "").trim(),
    body: String(formData.get("body") ?? "").trim(),
    tag: String(formData.get("tag") ?? "").trim(),
  };

  if (!values.title || !values.subtitle || !values.body) {
    error = "Completá el título, el subtítulo y el cuerpo de la nota";
  } else {
    // The slug doubles as the upload directory key so the note and its image
    // share a stable location under `notes/<slug>/`.
    const slug = slugify(values.title);

    let imageUrl = "";
    const image = formData.get("image");
    if (isNonEmptyFile(image)) {
      try {
        const saved = await saveImageUpload(image, slug, {
          uploadsDir: UPLOADS_DIR,
          publicUploadsUrl: PUBLIC_UPLOADS_URL,
          maxBytes: MAX_UPLOAD_SIZE_BYTES,
        });
        imageUrl = saved.publicUrl;
      } catch (e) {
        error = e instanceof Error ? e.message : "No se pudo guardar la imagen";
      }
    }

    if (!error) {
      const note = await createNote({
        title: values.title,
        subtitle: values.subtitle,
        body: values.body,
        imageUrl,
        slug,
        tag: values.tag || undefined,
      });
      return Astro.redirect(`/operativos-de-salud/${note.slug}/`);
    }
  }
}
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-4 py-24 md:py-32">
    <WriterForm server:defer error={error} values={values} />
  </main>
</BaseLayout>
