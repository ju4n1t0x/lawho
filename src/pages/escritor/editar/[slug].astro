---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WriterForm from "../../../components/server-islands/WriterForm.astro";
import { getNoteBySlug, updateNote } from "../../../lib/notes-repo";
import {
  MAX_UPLOAD_SIZE_BYTES,
  PUBLIC_UPLOADS_URL,
  UPLOADS_DIR,
} from "astro:env/server";
import { saveImageUpload, resolveNoteImageReplacement } from "../../../lib/uploads";
import { SESSION_COOKIE_NAME } from "../../../lib/session";
import { getActiveSession } from "../../../lib/session-repo";
import { unlink } from "node:fs/promises";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/escritor/");
}

const note = await getNoteBySlug(slug);
if (!note) {
  return new Response("Nota no encontrada", { status: 404 });
}

let error: string | undefined;
let values = {
  title: note.data.title,
  subtitle: note.data.subtitle,
  body: note.body,
  tag: note.data.tag ?? "",
};

/** Guard against non-`File` entries returned by the multipart parser. */
function isNonEmptyFile(value: unknown): value is File {
  return (
    value !== null &&
    typeof value === "object" &&
    "size" in value &&
    typeof (value as File).size === "number" &&
    (value as File).size > 0 &&
    "arrayBuffer" in value
  );
}

if (Astro.request.method === "POST") {
  const token = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
  const session = token ? await getActiveSession(token) : null;
  if (!session) {
    return Astro.redirect("/escritor/");
  }

  const formData = await Astro.request.formData();
  values = {
    title: String(formData.get("title") ?? "").trim(),
    subtitle: String(formData.get("subtitle") ?? "").trim(),
    body: String(formData.get("body") ?? "").trim(),
    tag: String(formData.get("tag") ?? "").trim(),
  };

  if (!values.title || !values.subtitle || !values.body) {
    error = "Completá el título, el subtítulo y el cuerpo de la nota";
  } else {
    const image = formData.get("image");
    const hasNewUpload = isNonEmptyFile(image);

    // Save new upload first (if present) to get the public URL.
    let newPublicUrl: string | undefined;
    if (hasNewUpload) {
      try {
        const saved = await saveImageUpload(image, slug, {
          uploadsDir: UPLOADS_DIR,
          publicUploadsUrl: PUBLIC_UPLOADS_URL,
          maxBytes: MAX_UPLOAD_SIZE_BYTES,
        });
        newPublicUrl = saved.publicUrl;
      } catch (e) {
        error = e instanceof Error ? e.message : "No se pudo guardar la imagen";
      }
    }

    if (!error) {
      const decision = resolveNoteImageReplacement({
        currentPublicUrl: note.data.image,
        hasNewUpload,
        newPublicUrl: newPublicUrl ?? "",
        config: { uploadsDir: UPLOADS_DIR, publicUploadsUrl: PUBLIC_UPLOADS_URL },
      });

      if (decision.rejectMessage) {
        error = decision.rejectMessage;
      } else {
        const updated = await updateNote(slug, {
          title: values.title,
          subtitle: values.subtitle,
          body: values.body,
          tag: values.tag || undefined,
          imageUrl: decision.persistNewUrl ? decision.imageUrl : undefined,
        });
        if (!updated) {
          return new Response("Nota no encontrada", { status: 404 });
        }

        // Unlink the old file only AFTER the DB write succeeded. Non-fatal.
        if (decision.oldAbsolutePath) {
          try {
            await unlink(decision.oldAbsolutePath);
          } catch (e) {
            console.error("Failed to unlink old image:", e);
          }
        }

        return Astro.redirect("/escritor/");
      }
    }
  }
}
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-4 py-24 md:py-32">
    <WriterForm
      server:defer
      mode="update"
      error={error}
      values={values}
      imageUrl={note.data.image}
      actionUrl={`/escritor/editar/${slug}`}
    />
  </main>
</BaseLayout>
