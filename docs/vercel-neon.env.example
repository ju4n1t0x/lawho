# Copy to a gitignored .env for local work. Never commit real values.
# Runtime: use an isolated branch and a restricted database role.
DATABASE_HOST=your_pooled_neon_host_here
DATABASE_PORT=5432
DATABASE_USER=your_runtime_role_here
DATABASE_PASSWORD=your_runtime_password_here
DATABASE_NAME=your_database_here
DATABASE_SSL=true

# Storage: private bucket, branch-specific HTTPS endpoint and scoped credential.
AWS_ENDPOINT_URL_S3=https://your-branch.storage.example.invalid
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_storage_access_key_here
AWS_SECRET_ACCESS_KEY=your_storage_secret_here
STORAGE_BUCKET=lawhobucket
MAX_UPLOAD_SIZE_BYTES=5242880
SESSION_TTL_MS=86400000

# Maintenance tools only. Keep it in the local gitignored .env: Vercel has no
# build-only variables, so a value set there is also readable by functions.
MIGRATION_DATABASE_URL=postgresql://migration_role:replace_me@your_direct_host/database?sslmode=verify-full
