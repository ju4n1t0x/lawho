# LaWho environment variables (placeholders only — copy to `.env` and fill real values)
# Access: declare vars in astro.config.mjs `env.schema`; import from `astro:env/server`.

DATABASE_HOST=your_database_host_here
DATABASE_PORT=5432
DATABASE_USER=your_database_user_here
DATABASE_PASSWORD=your_database_password_here
DATABASE_NAME=your_database_name_here
DATABASE_SSL=false
