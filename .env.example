# LaWho environment variables (placeholders only — copy to `.env` and fill real values)
# Access: declare vars in astro.config.mjs `env.schema`; import from `astro:env/server`.

# PostgreSQL connection (consumed by src/lib/db.ts at runtime)
DATABASE_HOST=your_database_host_here
DATABASE_PORT=5432
DATABASE_USER=your_database_user_here
DATABASE_PASSWORD=your_database_password_here
DATABASE_NAME=your_database_name_here
DATABASE_SSL=false

# Session lifetime in milliseconds (default 24h)
SESSION_TTL_MS=86400000

# Local filesystem directory where uploaded images are written
UPLOADS_DIR=./uploads

# Public URL origin prefix stored in the DB for uploaded images (never a local path)
PUBLIC_UPLOADS_URL=/uploads

# Upload size cap in bytes (default 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Optional — reserved for future signing; not consumed by the current DB-session model
# SESSION_SECRET=your_session_secret_here
